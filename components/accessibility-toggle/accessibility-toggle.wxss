.a11y-widget {
  position: fixed;
  top: 10rpx;
  left: 8rpx;
  z-index: 999;
}

.a11y-trigger {
  position: relative;
  width: 116rpx;
  height: 132rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  border: none;
  border-radius: 0;
  background: transparent;
  color: #171c1b;
  font-size: 20rpx;
  font-weight: 900;
  box-shadow: none;
  overflow: visible;
  padding: 0;
}

.a11y-trigger::after {
  border: none;
}

.a11y-mascot {
  position: absolute;
  left: 50%;
  top: 0;
  width: 92rpx;
  height: 92rpx;
  transform: translateX(-50%);
  pointer-events: none;
}

.a11y-label {
  min-width: 88rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  padding: 0 16rpx;
  background: linear-gradient(135deg, #f5df63, #fff4ad);
  color: #171c1b;
  font-size: 20rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 18rpx rgba(42, 42, 56, 0.12);
}

.a11y-panel {
  position: absolute;
  left: 0;
  top: 138rpx;
  width: 560rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 24rpx 62rpx rgba(42, 42, 56, 0.22);
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.panel-title {
  color: #343b39;
  font-size: 28rpx;
  font-weight: 900;
}

.panel-close {
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0eef4;
  color: #343b39;
  font-size: 34rpx;
  font-weight: 700;
}

.setting-row,
.language-row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(54, 65, 63, 0.12);
}

.language-row {
  border-bottom: none;
}

.setting-title {
  color: #343b39;
  font-size: 26rpx;
  font-weight: 900;
}

.setting-desc {
  margin-top: 6rpx;
  color: #5b6562;
  font-size: 23rpx;
  line-height: 1.35;
}

.chevron {
  color: #6a2e86;
  font-size: 44rpx;
  line-height: 1;
}
