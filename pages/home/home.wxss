.home-a11y {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 210rpx;
  margin-bottom: 30rpx;
  padding-top: 36rpx;
  overflow: hidden;
  z-index: 4;
}

.welcome-deco {
  position: absolute;
  left: 50%;
  top: 42rpx;
  transform: translateX(-50%);
  color: transparent;
  font-size: 126rpx;
  font-weight: 900;
  line-height: 1;
  background: linear-gradient(90deg, rgba(106, 46, 134, 0.32), rgba(78, 158, 145, 0.28), rgba(245, 223, 99, 0.36));
  -webkit-background-clip: text;
  background-clip: text;
  filter: blur(2rpx);
  opacity: 0.86;
  white-space: nowrap;
  z-index: 1;
  pointer-events: none;
}

.home-a11y-mascot {
  width: 118rpx;
  height: 130rpx;
  margin-bottom: 10rpx;
  z-index: 2;
}

.home-a11y-pill {
  min-height: 58rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f5df63, #fff4ad);
  color: #171c1b;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 24rpx rgba(42, 42, 56, 0.12);
  position: relative;
  z-index: 2;
}

.home-a11y-panel {
  width: 100%;
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 24rpx 58rpx rgba(42, 42, 56, 0.16);
  position: relative;
  z-index: 3;
}

.page.a11y-reduced .welcome-deco {
  display: none;
}

.setting-row,
.language-row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(54, 65, 63, 0.12);
}

.language-row {
  border-bottom: none;
}

.setting-title {
  color: #343b39;
  font-size: 26rpx;
  font-weight: 900;
}

.setting-desc {
  margin-top: 6rpx;
  color: #5b6562;
  font-size: 23rpx;
  line-height: 1.35;
}

.chevron {
  color: #6a2e86;
  font-size: 44rpx;
  line-height: 1;
}

.hero {
  position: relative;
  overflow: visible;
  padding-top: 38rpx;
  background:
    radial-gradient(circle at 86% 22%, rgba(216, 192, 228, 0.62), transparent 28%),
    radial-gradient(circle at 12% 88%, rgba(185, 221, 214, 0.58), transparent 30%),
    rgba(255, 255, 255, 0.9);
}

.hero-top {
  position: relative;
  z-index: 1;
  max-width: 610rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
  margin-top: 30rpx;
}

.hero-stickers {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
}

.sticker {
  min-height: 58rpx;
  display: flex;
  align-items: center;
  border: none;
  border-radius: 999rpx;
  padding: 6rpx 24rpx;
  color: #171c1b;
  font-size: 23rpx;
  font-weight: 900;
}

.sticker.teal {
  background: linear-gradient(135deg, #b9ddd6, #e7f6f3);
}

.sticker.yellow {
  background: linear-gradient(135deg, #f5df63, #fff4ad);
}

.sticker.purple {
  background: linear-gradient(135deg, #d8c0e4, #f1e5f7);
}

.compact-title {
  padding: 0 8rpx;
}

.quote-section {
  margin-top: 62rpx;
  margin-bottom: 62rpx;
  padding: 0 10rpx;
}

.quote-text {
  color: #343b39;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.42;
}

.test-panel {
  position: relative;
  background:
    radial-gradient(circle at 78% 18%, rgba(216, 192, 228, 0.56), transparent 30%),
    linear-gradient(135deg, #e8f8f4, #fff8ee);
  margin-top: 66rpx;
  padding-top: 54rpx;
  overflow: visible;
}

.test-badge {
  position: absolute;
  left: 50%;
  top: 0;
  transform: translate(-50%, -50%);
  z-index: 2;
  min-width: 180rpx;
  justify-content: center;
  background: #8a55a3;
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(106, 46, 134, 0.16);
}

.test-title {
  margin-top: 0;
}

.test-layout {
  display: grid;
  grid-template-columns: 1fr 210rpx;
  gap: 24rpx;
  align-items: end;
}

.tangtang {
  width: 100%;
  height: 300rpx;
  align-self: end;
}

.full {
  width: 100%;
  margin-top: 24rpx;
}

.link {
  color: #6a2e86;
  font-size: 26rpx;
  font-weight: 900;
}

.cta {
  margin-bottom: 24rpx;
}
