.detail-title {
  margin-bottom: 18rpx;
}

.case-hero-image {
  width: 100%;
  height: 520rpx;
  display: block;
  border: none;
  border-radius: 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(106, 46, 134, 0.14);
}

.card .body {
  margin-top: 16rpx;
}

.service-list {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
}

.service-name {
  color: #171c1b;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.full {
  width: 100%;
  margin-top: 24rpx;
}
