.chip-scroll {
  margin-top: 30rpx;
  white-space: nowrap;
}

.chip-row {
  display: inline-flex;
  gap: 18rpx;
  padding-bottom: 8rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  padding: 0 30rpx;
  border: none;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #171c1b;
  font-size: 24rpx;
  font-weight: 900;
}

.chip.active {
  background: linear-gradient(135deg, #b9ddd6, #d8c0e4);
  color: #171c1b;
}

.case-list {
  display: grid;
  gap: 32rpx;
}

.case-title {
  margin-top: 22rpx;
  color: #171c1b;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
}

.case-image {
  width: 100%;
  height: 260rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: none;
  border-radius: 18rpx;
  background: #fff8ee;
  color: #6a2e86;
  font-size: 28rpx;
  font-weight: 900;
  overflow: hidden;
}

.case-image.placeholder {
  background:
    linear-gradient(135deg, rgba(106, 46, 134, 0.14), rgba(78, 158, 145, 0.18)),
    #fff8ee;
}

.case-card .body {
  margin-top: 12rpx;
}

.small {
  width: 100%;
  min-height: 84rpx;
  margin-top: 28rpx;
}
