.org-list,
.service-list {
  display: grid;
  gap: 24rpx;
  margin-top: 26rpx;
}

.org-card {
  min-height: 120rpx;
}

.org-name,
.service-name {
  color: #171c1b;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.question-card {
  margin-top: 28rpx;
}

.question-text {
  margin-top: 18rpx;
  color: #171c1b;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.55;
}

.answer-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 20rpx;
}

.answer {
  min-height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 999rpx;
  background: #ffffff;
  color: #171c1b;
  font-size: 25rpx;
  font-weight: 900;
}

.answer.active {
  background: linear-gradient(135deg, #6a2e86, #4e9e91);
  color: #ffffff;
}

.full {
  width: 100%;
  margin-top: 24rpx;
}

.result-hero {
  text-align: center;
}

.score {
  margin-top: 8rpx;
  color: #6a2e86;
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1;
}

.level {
  margin: 16rpx 0;
  color: #171c1b;
  font-size: 34rpx;
  font-weight: 800;
}

.dimension {
  margin-top: 22rpx;
}

.dimension-name {
  color: #171c1b;
  font-size: 26rpx;
  font-weight: 800;
}

.dimension-score {
  color: #6a2e86;
  font-size: 25rpx;
  font-weight: 800;
}

.bar {
  height: 14rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: #eee5d7;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #4e9e91;
}
