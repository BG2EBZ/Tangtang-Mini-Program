<view class="page {{a11yClass}}" wx:if="{{item}}">  <view class="panel">
    <view class="tag">{{item.category || item.type}}</view>
    <view class="h1 detail-title">{{item.title}}</view>
    <view class="body">{{item.summary}}</view>
  </view>

  <view class="section card">
    <view class="h2">内容</view>
    <view class="paragraph" wx:for="{{item.body}}" wx:key="*this">{{item}}</view>
  </view>

  <view class="section" wx:if="{{relatedServices.length}}">
    <view class="h2">相关服务</view>
    <view class="service-list">
      <view class="card" wx:for="{{relatedServices}}" wx:key="id" bindtap="openService" data-id="{{item.id}}">
        <view class="service-name">{{item.name}}</view>
        <view class="muted">{{item.summary}}</view>
      </view>
    </view>
  </view>

  <view class="section panel">
    <view class="h2">想知道你的机构适合从哪里开始？</view>
    <view class="body">先做一次包容性自测，了解当前基础和优先改进方向。</view>
    <button class="btn primary full" bindtap="goSelfTest">做一次包容性自测</button>
  </view>
</view>
