.detail-title {
  margin-bottom: 18rpx;
}

.visual-card {
  overflow: hidden;
  border-radius: 24rpx;
  background: #fffdf7;
  border: none;
  box-shadow: 0 16rpx 36rpx rgba(78, 158, 145, 0.14);
}

.visual-image {
  display: block;
  width: 100%;
  height: 420rpx;
}

.visual-placeholder {
  min-height: 320rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  text-align: center;
  background:
    linear-gradient(135deg, rgba(106, 46, 134, 0.12), rgba(78, 158, 145, 0.14)),
    #fff8ee;
}

.visual-mark {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  border: none;
  color: #6a2e86;
  font-size: 24rpx;
  font-weight: 900;
}

.visual-label {
  margin-top: 20rpx;
  color: #171c1b;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
}

.visual-note {
  margin-top: 10rpx;
  color: #5b6562;
  font-size: 24rpx;
  line-height: 1.45;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.card .body,
.price-panel .body {
  margin-top: 16rpx;
}

.full {
  width: 100%;
  margin-top: 24rpx;
}
